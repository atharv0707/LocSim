<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app talks plain HTTP to LocSimServer on your Mac (home Wi-Fi, hotspot or Tailscale).
	     Only NSAllowsArbitraryLoads: adding NSAllowsLocalNetworking would make iOS ignore it
	     and block Tailscale (100.x.x.x) addresses. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LocSim shows your iPhone's current location on the map so you can check the simulated location is working.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LocSim sends the location you pick to LocSimServer on your Mac.</string>
</dict>
</plist>
